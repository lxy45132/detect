# ===== Detect 部署配置模板 =====
# 用法：复制为 .env 后按服务器实际情况修改  ->  cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 【必填】服务器对外 IP 或域名
# 用途：detect-event 生成 MinIO 图片预签名 URL，前端浏览器直接 <img> 加载。
# 不能填 localhost / 127.0.0.1（那是访问者自己的电脑），否则前端所有抓拍图片裂开。
# 内网部署填内网 IP，公网部署填公网 IP 或域名（有 HTTPS 则用 https://域名:端口）。
SERVER_IP=192.168.1.100

# 前端 HTTP 访问端口（浏览器打开 http://SERVER_IP:此端口 进入系统）
WEB_HTTP_PORT=80

# 前端项目路径（相对本 docker 目录，或填绝对路径）
# 默认对应布局：Java/Detect/docker 与 Front/Detect 同在一个父目录下。
# 服务器上若目录结构不同，改成前端项目的实际路径，例如 /opt/detect/frontend
FRONTEND_CONTEXT=../../../Front/Detect
